# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed - see the security incident this project fixed.

NODE_ENV=development
PORT=4000

# Used directly by the API, and by docker-compose to provision the db
# service (POSTGRES_USER/PASSWORD/DB below must match the credentials here).
# Host "db" is the docker-compose service name - if running the API outside
# Docker against the compose-managed Postgres, use localhost:5435 instead.
DATABASE_URL=postgresql://wartungstermine:wartungstermine@db:5432/wartungstermine

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-random-64-char-hex-string
JWT_REFRESH_SECRET=replace-with-a-different-random-64-char-hex-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated list of origins allowed to call this API, e.g.
# http://localhost:5173,https://wartungstermine.example
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# SMTP: point at Mailpit for local dev (docker compose service "mailpit"),
# or your real provider in production. Never hardcode credentials here -
# this file only documents the expected shape.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Nordlicht IT Services <no-reply@nordlicht-it.example>

# Daily at 07:00 server time by default.
NOTIFICATION_CRON_SCHEDULE=0 7 * * *
NOTIFICATION_DUE_SOON_DAYS=14

# docker-compose db service only.
POSTGRES_USER=wartungstermine
POSTGRES_PASSWORD=wartungstermine
POSTGRES_DB=wartungstermine
